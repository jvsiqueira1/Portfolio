# Google Analytics (Measurement ID, ex.: G-XXXXXXXXXX)
# Em produção, configure esta variável nas Environment Variables do Vercel.
# Sem valor definido, o banner de cookies continua funcionando, mas nenhum
# script de tracking é carregado.
NEXT_PUBLIC_GA_ID=

# ScreenshotOne (usado por `npm run screenshots` para gerar os PNGs dos projetos)
SCREENSHOT_ONE_ACCESS_KEY=
SCREENSHOT_ONE_SECRET_KEY=
